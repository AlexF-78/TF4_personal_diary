# .env.sample - Шаблон для Personal Diary Django проекта


# СЕКРЕТНЫЙ КЛЮЧ DJANGO (обязательно измените!)
SECRET_KEY='django-insecure-сгенерируйте-уникальный-ключ'

# РЕЖИМ РАЗРАБОТКИ (True для разработки, False для продакшена)
DEBUG=True

# НАСТРОЙКИ ПОДКЛЮЧЕНИЯ К БАЗЕ ДАННЫХ
# Для локальной разработки (без Docker):
DB_NAME=personal_diary
DB_USER=postgres
DB_PASSWORD=ваш_пароль_для_postgres
DB_HOST=localhost
DB_PORT=5432

# Для работы с Docker Compose (значения ниже уже заданы в docker-compose.yml):
# DB_NAME=personal_diary
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=db
# DB_PORT=5432