# =====================================================
# .env.example - Шаблон файла переменных окружения
# =====================================================
# КОПИРУЙТЕ ЭТОТ ФАЙЛ В .env И ЗАПОЛНИТЕ СВОИМИ ЗНАЧЕНИЯМИ
# НИКОГДА НЕ КОММИТЬТЕ РЕАЛЬНЫЙ .env ФАЙЛ В GIT!
# =====================================================

# -------------------------------
# 1. БАЗОВЫЕ НАСТРОЙКИ DJANGO
# -------------------------------

# Секретный ключ Django (сгенерируйте новый для продакшена)
SECRET_KEY='django-insecure-сгенерируйте-новый-секретный-ключ-здесь'

# Режим отладки (True для разработки, False для продакшена)
DEBUG=True

# Разрешенные хосты (через запятую)
ALLOWED_HOSTS=localhost,127.0.0.1

# -------------------------------
# 2. НАСТРОЙКИ БАЗЫ ДАННЫХ POSTGRESQL
# -------------------------------

# Локальная разработка (без Docker)
DB_NAME=personal_diary
DB_USER=postgres
DB_PASSWORD=ваш_пароль_здесь
DB_HOST=localhost
DB_PORT=5432

# ИЛИ для Docker (используется в docker-compose.yml)
# DATABASE_URL=postgres://postgres:ваш_пароль@db:5432/personal_diary

# -------------------------------
# 3. НАСТРОЙКИ ЭЛЕКТРОННОЙ ПОЧТЫ
# -------------------------------

# Для тестирования (письма выводятся в консоль)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@personal-diary.local

# Для реальной отправки (раскомментируйте и настройте):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yandex.ru          # Или smtp.gmail.com, smtp.mail.ru
# EMAIL_PORT=465                     # Для SSL
# EMAIL_USE_SSL=True                 # Или EMAIL_USE_TLS=True для порта 587
# EMAIL_HOST_USER=ваш_email@domain.ru
# EMAIL_HOST_PASSWORD=ваш_пароль_от_почты

# -------------------------------
# 4. ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ (ОПЦИОНАЛЬНО)
# -------------------------------

# Настройки статических файлов (если отличаются от стандартных)
# STATIC_URL=/static/
# STATIC_ROOT=staticfiles

# Настройки медиа файлов (если есть загрузка файлов)
# MEDIA_URL=/media/
# MEDIA_ROOT=media

# Язык и временная зона
# LANGUAGE_CODE=ru-ru
# TIME_ZONE=Europe/Moscow
# EMAIL SETTINGS

# Для тестирования (письма в консоль)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Для реальной отправки через Mail.ru (раскомментировать при необходимости)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.mail.ru
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=your_email@mail.ru
# EMAIL_HOST_PASSWORD=your_app_password

# Для реальной отправки через Gmail (раскомментировать при необходимости)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
# TIMEZONE SETTINGS (Для Celery задач)
# TIME_ZONE=Europe/Moscow
# USE_TZ=True
# -------------------------------
# 5. НАСТРОЙКИ ДЛЯ DOCKER (ОПЦИОНАЛЬНО)
# -------------------------------

# При использовании Docker Compose, эти переменные могут быть заданы в docker-compose.yml
# DATABASE_URL=postgres://postgres:postgres@db:5432/personal_diary
# DEBUG=False  # В продакшене всегда False